# Frontend (.env.local) — safe to expose to the browser
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="your-anon-key"
# Optional
VITE_SENTRY_DSN=""
# "true" only on a Supabase plan with image transforms (resized dish photos)
VITE_SUPABASE_IMAGE_TRANSFORMS=""

# Seed script only (.env.seed) — NEVER put this in .env.local or commit it
# SUPABASE_URL="http://127.0.0.1:54321"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
